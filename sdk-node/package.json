{
  "name": "@corezt/ztxbas",
  "version": "1.0.0",
  "description": "Official Node/TypeScript SDK for ZTXBAS — Zero-Trust Biometric Authentication Server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ztxbas",
    "biometric",
    "authentication",
    "mfa",
    "zero-trust",
    "corezt"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/corezt/ztxbas.git",
    "directory": "sdk-node"
  }
}
